    "discord": "https://discord.gg/xxybrgF",
    "donate": "https://paypal.me/DanMizu",
    "modrinth": "https://modrinth.com/project/not-enough-management"
  },

  "license": "GPL-3.0",
  "icon": "assets/not-enough-management/icon.png",

  "environment": "server",
  "entrypoints": {
    "main": ["dev.danmizu.not_enough_management.NotEnoughManagement"]
  },

  "mixins": [
    "not-enough-management.mixins.json"
